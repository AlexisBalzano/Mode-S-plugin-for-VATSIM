<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test tool: simulates a pilot on the live broker, probes the MSFS module, or loads the
       vPilot plugin with a fake vPilot. 32-bit, like vPilot and its SimConnect library. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x86</PlatformTarget>
    <VpilotDir Condition="'$(VpilotDir)' == ''">C:\vPilot</VpilotDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\vpilot-plugin\EhsLinkVpilot.csproj" />
    <Reference Include="RossCarlson.Vatsim.Vpilot.Plugins">
      <HintPath>$(VpilotDir)\RossCarlson.Vatsim.Vpilot.Plugins.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(VpilotDir)\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
    </Reference>
    <!-- native SimConnect.dll next to the exe (local test tool only, not redistributed) -->
    <None Include="$(VpilotDir)\SimConnect.dll" Link="SimConnect.dll" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
